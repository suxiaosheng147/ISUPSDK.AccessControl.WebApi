<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <!--
          关键：移除 IIS 的 WebDAV 模块。
          装了「WebDAV 发布」的 IIS 会在 ASP.NET Core 之前拦截 PUT / DELETE / PATCH / MKCOL 等谓词，
          直接返回 405.0（详细错误里模块=WebDAVModule、通知=MapRequestHandler），ASP.NET Core 收不到请求。
          影响面：门控制（PUT /api/access-control/doors/1/control、.../open 等）、输出触发（PUT .../trigger）、
                  以及人员/卡片/人脸等一切 PUT / PATCH / DELETE 写接口。
        -->
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        预热（web.config 能做的只有这一层）：
        - doAppInitAfterRestart：应用池重启/回收后，IIS 立刻对 initializationPage 发一次请求，
          把 SDK 初始化、EF Core 建表/补列、事件 spool 恢复这些"慢启动"工作提前做完，
          第一个真实请求（以及设备重连）不必再等冷启动。
        - 预热页选 /health：轻量、不落库、不触发设备操作，返回体里的 status 可直接看 SDK 是否就绪。
        注意：这一节只解决「进程起来之后立刻预热」。
              「进程不要被空闲杀掉」属于应用池设置（AlwaysRunning + preloadEnabled + idleTimeout=0），
              只能在 applicationHost.config 里配，web.config 写不了 → 用仓库根的 iis-apppool.ps1。
      -->
      <applicationInitialization doAppInitAfterRestart="true">
        <add initializationPage="/health" />
      </applicationInitialization>

      <!--
        hostingModel=inprocess：应用跑在 w3wp 内（进程就是 IIS 工作进程，端口 7660/8081 也归它）。
        startupTimeLimit  ：默认 120 秒。ISUP SDK 初始化 + 原生库加载 + 事件 spool 恢复留足时间。
        shutdownTimeLimit ：默认只有 10 秒，回收时 IIS 最多等这么久，超时直接杀；
                            当前 IsupSdkHostedService.StopAsync 还没做 SDK 清理，60 秒是给以后留的余量。
        stdoutLogEnabled  ：每次进程启动生成一个 logs\stdout_<UTC时间>_<pid>.log，不滚动。
                            保留开启便于排查「是不是又冷启动了」；确认稳定后可改 false。
      -->
      <aspNetCore processPath=".\ISUPSDK.AccessControl.WebApi.exe"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess"
                  startupTimeLimit="120"
                  shutdownTimeLimit="60" />
    </system.webServer>
  </location>
</configuration>
