    "IsAuthRuleBindMachine": "http://192.168.1.124:7845/IsAuthRuleBindMachine",
    "AuthRuleLeaveSyncDatasUrl": "http://192.168.1.124:7845/SyncLeaveData/LeaveSyncDatas",
    "AuthRuleLeaveResetSyncDatasUrl": "http://192.168.1.124:7845/SyncLeaveData/LeaveResetSyncDatas",
    "AuthRuleUpdateLeaveUrl": "http://192.168.1.124:7845/SyncLeaveData",
    "MaxTotalSleepTime": 10000,
    "MinTotalSleepTime": 5000,
    "ApiSleepTime": 3000,
    "SyncAcsEventUrl": "http://192.168.1.124:7845/SyncAcsEvent",
    // 0=HTTP（MonitorEventURL），1=保存图片在本地，图片名是具体信息
    "PushAccessType": 0,
    "ForceUpdatePic": true,
    "NightBoost": {
