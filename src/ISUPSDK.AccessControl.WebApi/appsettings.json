{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5190"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // 事件库/任务库是轮询取数的，SQL 命令日志会刷屏，降到 Warning。
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  // ---------------------------------------------------------------------------------------------
  // ISUP：Web API 宿主自身的配置（监听、原生库、日志）。
  // 业务配置仍沿用原控制台项目的 "Settings" 节，节名可通过 SettingsSection 调整。
  // ---------------------------------------------------------------------------------------------
  // ---------------------------------------------------------------------------------------------
  // 定时任务的 Cron 表达式（NCrontab，5 段或 6 段均可）。
  // 留空 / 删除该项表示不启动对应任务。
  // ---------------------------------------------------------------------------------------------
  "Crontab": {
    // 设备信息同步：周期遍历所有在线设备执行权限同步。
    "SyncDevices": "*/1 * * * *",

    // 设备校时：周期遍历所有在线设备下发当前时间。
    "DeviceTime": "*/30 * * * *"
  },
  "ISUP": {
    "SettingsSection": "Settings",

    // ISUP SDK 原生库目录（HCISUPCMS.dll / HCISUPAlarm.dll / HCISUPSS.dll / HCISUPStream.dll 等）。
    // 留空则依次探测：环境变量 ISUP_SDK_DIR / HCISUPSDK_DIR → 程序输出目录 → ./sdk → 上级目录。
    "NativeDirectory": "",

    // 启动时自动初始化 SDK 并监听设备注册（对应原控制台程序 Main 中的 InitLib）。
    "AutoStartListen": true,

    // SDK 各组件（CMS/Alarm/SS/Stream）的日志目录，对应 SDK 的 SetLogToFile。
    "SdkLogDirectory": "./logs/isupsdk/",

    // 业务日志根目录（Common.WriteFile / Common.WriteFileHours 使用）。
    // 离线设备记录的保留天数（设备表清理；<=0 不清理）。
    "DeviceOfflineRetentionDays": 7,

    "LogDirectory": "./logs/",
    // ---------------------------------------------------------------------------------------------
    // 门禁事件消息队列（事件 → 队列 → 消费者 → 数据库）
    // Provider：None-进程内直通 / Msmq-Windows 自带消息队列 / RabbitMq
    // ---------------------------------------------------------------------------------------------
    "EventQueue": {
      "Enabled": true,
      "Provider": "None",
      "QueueName": "acs-events",
      "IncludeAmsEvents": true,
      "AccessControlOnly": false,
      "PendingBufferSize": 50000,
      "PublishRetryDelaySeconds": 3,
      "PublishMaxAttempts": 5,
      "DeadLetterFile": "./logs/acs-queue/deadletter.jsonl",
      "Msmq": {
        "QueuePath": "",
        "CreateIfMissing": true,
        "Transactional": false,
        "ReceiveTimeoutMs": 2000,
        "MaxMessageBytes": 4194304,
        "LabelPrefix": "acs-event:",
        "ReconnectDelaySeconds": 5,
        "QueueCheckSeconds": 30
      },
      "RabbitMq": {
        "HostName": "127.0.0.1",
        "Port": 5672,
        "VirtualHost": "/",
        "UserName": "guest",
        "Password": "guest",
        "UseTls": false,
        "Durable": true,
        "PrefetchCount": 50,
        "MaxMessageBytes": 4194304,
        "ReconnectDelaySeconds": 5,
        "DeadLetterEnabled": false
      },
      "Consumer": {
        "Enabled": true,
        "BatchSize": 100,
        "FlushIntervalMs": 1000,
        "MaxAttempts": 5,
        "RetryDelaySeconds": 5,
        "ReplaySpoolOnStartup": true,
        "ReplaySpoolDays": 2,
        // 入库前解析抓拍图：JSON 报文带 pictureURL（Digest 直连/对账/推送）用 Digest 下载落盘；
        // SDK 报警回调的 XML 只把 Params.PicDataUrl 展开成完整 URL 存进事件（图片服务器可直接访问，不下载）。
        // 之后 GET /api/events 的 pictures / pictureUrls 才有值
        "DownloadPictures": true,
        // 单批最多下载多少张抓拍图（0=不限），避免一批上百条事件同时向设备取图
        "MaxPictureDownloadsPerBatch": 50
      }
    },

    // ---- 异步下发任务库（人员 / 卡片 / 人脸的写操作入队后由后台执行）----
    // Provider：Sqlite-默认 / MySql / SqlServer；非 Sqlite 时必须配 ConnectionString。
    // 记录保留：CompletedRetentionDays 天前已结束（CompletedAt 有值）的任务按 RetentionSweepHours 周期清理，
    //           待执行/执行中的任务不清理，0 表示不自动清理。
    "TaskQueue": {
      "Enabled": true,
      "Provider": "Sqlite",
      "ConnectionString": "",
      "ServerVersion": "8.0.36",
      "DatabasePath": "./storage/acs-tasks.db",
      "CommandTimeoutSeconds": 30,
      "PollSeconds": 5,
      "OfflineRetrySeconds": 15,
      "MaxAttempts": 3,
      // AcsTask 记录保留天数（0 = 不清理）
      "CompletedRetentionDays": 30,
      "RetentionSweepHours": 1,
      "BinaryDirectory": "./storage/task-files/",
      "BatchSize": 20
    },

    // ---- 门禁事件落库（消费者写入）----
    // Provider：Sqlite-默认 / MySql / SqlServer
    // 记录保留：RetentionDays 天前的事件（按 EventTime）按 RetentionSweepHours 周期清理，0 表示不清理。
    "EventStore": {
      "Enabled": true,
      "Provider": "Sqlite",
      "ConnectionString": "",
      "SqlitePath": "./storage/acs-events.db",
      "ServerVersion": "8.0.36",
      "AutoCreate": true,
      "TableName": "AcsEvents",
      "CommandTimeoutSeconds": 30,
      "StorePayload": true,
      "MaxPayloadBytes": 262144,
      // AcsEventRecord 记录保留天数（0 = 不清理）
      "RetentionDays": 90,
      "RetentionSweepHours": 24
    },

    // ---- 历史事件对账（定时从设备拉取历史事件，补齐回调丢失的缺口）----
    "EventReconcile": {
      "Enabled": true,
      "IntervalSeconds": 300,
      "LookbackSeconds": 900,
      "OverlapSeconds": 60,
      "PageSize": 100,
      "MaxPagesPerRun": 20,
      "TimeoutMs": 30000,
      "Major": 0,
      "Minor": 0,
      "Devices": [],
      // 对账 / 高频轮询补的事件是否用 Digest 下载抓拍图（入库后 GET /api/events 的 pictures / pictureUrls 才有值）
      "DownloadPictures": true,
      // 单设备单轮最多发起多少次抓拍图下载（0=不限）：启动补历史时设备上的图多半已被覆盖，限流避免拖慢对账
      "MaxPictureDownloadsPerRun": 200,
      // 启动时若事件表为空，自动补一次历史（首次部署 / 换库回填）；补历史区间不推进增量基准
      "StartupBackfillWhenEmpty": true,
      "StartupBackfillDays": 60
    },

    // ---- ISAPI 报文发往设备的通道（按设备编号切换）----
    // 四条通道的「请求路径 + 报文体」完全相同，区别只是「谁把这条 HTTP 请求发出去」：
    //   http-sdk           = SDK 转发 HTTP 请求（NET_ECMS_ISAPIPassThrough，请求行带方法："POST /ISAPI/AccessControl/..."）
    //   http-IsapiDigest   = 平台 Digest 直连设备（HttpClient + Digest 认证，地址/账号取自下面的 IsapiDigest:Devices，不经 SDK）
    //   http-http          = 与 http-IsapiDigest 完全相同（同一实现的别名）
    //   http-xml           = 透传（NET_ECMS_Get/Put/Post/DeletePTXMLConfig，按方法调对应接口，请求行只有路径）
    // 部分旧固件只认其中某一条（例如 http-xml 取事件返回空、http-sdk 报错），可在此逐台切换。
    // 人脸图片上传（multipart）固定走 http-xml：ISAPI 透传的参数结构体没有分段字段，带不了 boundary。
    "IsapiChannel": {
      // 未在 Devices 中列出的设备使用该通道
      "DefaultChannel": "http-sdk",
      // 个别设备单独指定通道（DeviceId 与设备表 / 报警回调里的设备编号一致，忽略大小写）
      "Devices": [
        // { "DeviceId": "FZ7955795", "Channel": "http-xml" }
      ]
    },

    // ---- 门禁业务行为 ----
    // DoorControlFormat：门远程控制（开门/关门/常开/常闭）的报文格式
    //   Json = 固定 JSON 报文（PUT ...?format=json + {"RemoteControlDoor":{"cmd":"open"}}），海康通用，代码默认值
    //   Xml  = 固定 XML 报文（同一路径但不带 format=json，<RemoteControlDoor><cmd>open</cmd></RemoteControlDoor>）
    //          实测 DS-K1T670M 只认 XML：发 JSON 会回 MessageParametersLack（参数节点不存在）
    //   Auto = 先发 JSON，设备以 MessageParametersLack / badParameters / notSupport 拒绝时自动重发 XML
    // 换设备后若开门失败，先看响应里的 data.status.subStatusCode 判断该用哪种。
    "AccessControl": {
      "DoorControlFormat": "Xml"
    },

    // ---- 设备 ISAPI 直连（HTTP Digest 认证）：对账的优先通道 ----
    // 不依赖 SDK 设备注册，直接用设备 IP + 账号密码拉取门禁事件（POST /ISAPI/AccessControl/AcsEvent?format=json）；
    // 这类报文带 pictureURL（人脸事件抓拍图），可下载后随转发报文给出本地路径。
    // 对账时优先走本通道：成功就不再用 SDK 对账，失败（连不上/认证失败/解析失败）才回退 SDK 透传兜底。
    "IsapiDigest": {
      "Enabled": true,
      "TimeoutSeconds": 30,
      "IgnoreSslErrors": true,
      "DownloadPictures": true,
      // 抓拍图落盘目录；留空时沿用 Settings:Photo（相对路径按程序运行目录解析）
      "PictureDirectory": ".//IsapiDigest//PictureDirectory/",
      // 抓拍图对外 URL 前缀（唯一来源，不再按 Settings:ServerAddress 推导）：
      // 转发报文 ExtEventPictureURL 与 GET /api/events 的 pictureUrls 都用它；
      // 例：http://10.0.0.5:5190/api/events/pictures（反代/域名写 https://acs.example.com/acs-pictures，末尾不带 /）；
      // 留空时用相对路径 /api/events/pictures（前端按页面同源解析，可直接显示图片）
      "PictureUrlPrefix": "http://192.168.1.12:5190/api/events/pictures",
      "MaxPictureBytes": 5242880,
      // 配置了 Digest 的设备在直连失败时是否回退 SDK 对账兜底（false = 只走直连）
      "FallbackToSdk": true,
      // 独立的 Digest 轮询：抓拍图会被设备循环覆盖，越早拉越能拿到（<=0 关闭，只在对账时用直连）
      "PollIntervalSeconds": 60,
      "PollLookbackSeconds": 300,
      "PollOverlapSeconds": 30,
      "PollMaxPages": 10,
      // 设备清单（可配多台）：DeviceId 要与 SDK/报警回调的设备编号一致（事件归属与去重用）
      "Devices": [
        {
          "DeviceId": "FZ7955795",
          "Host": "192.168.1.167",
          "Port": 443,
          "UseHttps": true,
          "UserName": "admin",
          "Password": "krbb2015"
        }
      ]
    },

    // ---- 设备侧 HTTP 上报（设备把事件以 multipart POST 到平台时的兜底通道）----
    "ACSHttpPush": {
      "Enabled": false,
      "ListenIp": "0.0.0.0",
      "ListenPort": 8083,
      "UrlPath": "",
      "AutoConfigureOnDeviceOnline": false,
      "AdvertiseAddress": "",
      "SavePictures": true,
      "PictureDirectory": "./logs/acs-push/pictures/",
      "SpoolDirectory": "./logs/acs-push/spool/",
      "PersistBeforeAck": true,
      "DedupCacheSize": 200000,
      "MaxBodyBytes": 33554432
    },

    // 跨域：便于独立部署的页面 / Vue 应用联调；生产建议改成具体来源。
    "Cors": {
      "Enabled": true,
      "AllowedOrigins": [ "*" ],
      "AllowedMethods": [ "*" ],
      "AllowedHeaders": [ "*" ],
      "AllowCredentials": false,
      "MaxAgeSeconds": 600
    }
  },

