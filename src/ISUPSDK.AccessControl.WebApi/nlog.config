<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="false">

  <!--
    ===========================================================================================
     本服务唯一的日志框架：NLog
    -------------------------------------------------------------------------------------------
     · 装配入口：Program.cs → builder.AddIsupNLog()（Modules/IsupLoggingModule.cs），
       它会 ClearProviders() 掉内置 Console/Debug provider，再 UseNLog()，所以
       宿主 ILogger<T> 与业务侧 IsupLog（Common.WriteFile*）最终都只走这一份配置。
     · 落盘布局（<日志根目录> 默认 .\logs\，由 ISUP:LogDirectory 决定）：
         业务日志：logs\log\<类名>\<yyyy-MM-dd>\<HH>.log     ← Common.WriteFile("SyncDoorData.txt", …)
         宿主日志：logs\log\<yyyy-MM-dd>\app.log              ← 控制器 / HostedService / EF Core / Kestrel
       「类名」= IsupLog 的分类（即原 WriteFile 的文件名去扩展名），未指定文件名的落在 logs\log\IsupLog\。
     · 改本文件后需重启进程（IIS 下回收应用池）生效：NLog 6 不再内置 nlog.config 文件监视。
     · SDK 原生库（HCISUPCMS/HCISUPAlarm/HCISUPSS）自己写的日志不受这里控制，
       仍由 ISUP:SdkLogDirectory（SetLogToFile）决定，默认 .\logs\isupsdk\。
    ===========================================================================================
  -->

  <!-- 兜底值：启动时被 Modules/IsupLoggingModule 改成 ISUP:LogDirectory 的绝对路径。 -->
  <variable name="logDir" value="${basedir}/logs" />

  <!-- 统一的正文格式：时间 级别 [类别] 消息（+ 异常堆栈）。 -->
  <variable name="bizLayout"
            value="${longdate} [${level:uppercase=true}] ${message}${onexception:${newline}${exception:format=ToString}}" />
  <variable name="appLayout"
            value="${longdate} [${level:uppercase=true}] ${logger}: ${message}${onexception:${newline}${exception:format=ToString}}" />

  <targets>
    <!--
      业务日志：<类名>\<yyyy-MM-dd>\<HH>.log
      ${logger:shortName=true} 取 logger 名最后一个点之后的部分，
      即 IsupLog.SyncDoorData → SyncDoorData，正好是"一个类一个文件夹"。
    -->
    <target xsi:type="File"
            name="bizFile"
            fileName="${var:logDir}/log/${logger:shortName=true}/${date:format=yyyy-MM-dd}/${date:format=HH}.log"
            layout="${bizLayout}"
            encoding="utf-8"
            createDirs="true"
            keepFileOpen="true" />

    <!-- 宿主日志：框架自身的流水汇总在一个文件里（<yyyy-MM-dd>\app.log），不按类分。 -->
    <target xsi:type="File"
            name="appFile"
            fileName="${var:logDir}/log/${date:format=yyyy-MM-dd}/app.log"
            layout="${appLayout}"
            encoding="utf-8"
            createDirs="true"
            keepFileOpen="true" />

    <!-- 控制台：以 IIS 承载时 stdout 无接收者（ANCM 的 stdout 日志已关闭），run.ps1 会重定向到 run\api.out.log -->
    <target xsi:type="Console"
            name="console"
            layout="${appLayout}" />

    <!-- Visual Studio 调试输出窗口 -->
    <target xsi:type="Debugger"
            name="debugger"
            layout="${level:uppercase=true} ${logger}: ${message}${onexception:${newline}${exception:format=ToString}}" />
  </targets>

  <rules>
    <!--
      业务日志（IsupLog 门面）：
      final="true" —— 命中后不再落到下面的 * 规则，避免同一行在 bizFile 与 appFile 里各写一遍。
      业务侧级别由调用方决定（WriteFile 恒为 Information），所以这里放到最低级别，不做二次过滤。
    -->
    <logger name="IsupLog*" minlevel="Trace" writeTo="bizFile,console" final="true" />

    <!-- 宿主日志：级别同时受 appsettings.json 的 "Logging:LogLevel" 过滤（如 EF Core SQL 降到 Warning） -->
    <logger name="*" minlevel="Info" writeTo="appFile,console" />

    <!-- 本地调试：Debug 级别只进 VS 输出窗口，不落盘 -->
    <logger name="*" minlevel="Debug" writeTo="debugger" />
  </rules>
</nlog>
